  "complexity": [
    "Converges in finite steps for linearly separable data",
    "Update rule: <code>w += lr * (target - output) * x</code>"
  ],
  "complexityNote": "The simplest neural network — a single neuron with step activation.",
  "steps": [
    "Compute weighted sum: z = w1*x1 + w2*x2 + bias",
    "Apply step activation: output = z >= 0 ? 1 : 0",
    "Compute error: error = target - output",
    "Update weights: w += learning_rate * error * x",
    "Repeat until all points classified correctly"
  ]
