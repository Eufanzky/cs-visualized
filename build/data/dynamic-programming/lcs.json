  "complexity": [
    "Time: <code>O(mn)</code> where m, n are string lengths",
    "Space: <code>O(mn)</code> for the DP table"
  ],
  "complexityNote": "Classic DP problem with applications in diff tools, bioinformatics, and version control.",
  "steps": [
    "Build table with rows = chars of A, cols = chars of B",
    "If chars match: dp[i][j] = dp[i-1][j-1] + 1 (diagonal)",
    "If not: dp[i][j] = max(dp[i-1][j], dp[i][j-1])",
    "Bottom-right cell = LCS length",
    "Backtrack to recover the actual subsequence"
  ]
